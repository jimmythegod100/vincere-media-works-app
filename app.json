{
  "expo": {
    "name": "Vincere Media Works",
    "slug": "vincere-media-works",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "vinceremediaworks",
    "description": "Video production, brand design, social content, and websites. Browse services, pricing, and contact Vincere Media Works.",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vinceremediaworks.app",
      "buildNumber": "2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.vinceremediaworks.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0a",
        "foregroundImage": "./assets/adaptive-icon.png"
      }
    },
    "web": {
      "favicon": "./assets/icon.png",
      "name": "Vincere Media Works",
      "shortName": "Vincere",
      "description": "Media production & brand design — video, logos, social, web.",
      "themeColor": "#0a0a0a",
      "backgroundColor": "#0a0a0a",
      "display": "standalone",
      "orientation": "portrait"
    },
    "plugins": ["expo-font", "expo-splash-screen"],
    "extra": {
      "eas": {
        "projectId": "REPLACE_AFTER_EAS_INIT"
      }
    },
    "owner": "jimmythegod100"
  }
}
